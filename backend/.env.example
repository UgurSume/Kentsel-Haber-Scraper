# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=kentsel_haber_db

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Scraping Configuration
SCRAPING_SCHEDULE_HOURS=24
SCRAPING_RUN_ON_STARTUP=False
SIMILARITY_THRESHOLD=0.90

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Stadium (Kocaelispor)
STADIUM_NAME=Kocaeli Stadyumu
STADIUM_LAT=40.7750844
STADIUM_LNG=30.017023
STADIUM_DISTRICT=İzmit
DEFAULT_STADIUM_RADIUS_KM=1.0
